rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Reads the caller's own profile to decide whether they are a pharmacist.
    // get() is a rules-side lookup and does not recurse into these rules.
    function isPharmacist() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacist';
    }

    // A patient can only reserve a code for their own account; any signed-in
    // user (i.e. a pharmacist) may look a single code up by its exact ID.
    // Listing the collection is deliberately not allowed.
    match /patientCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isPharmacist();
      allow create, update, delete: if isSelf(uid);

      // Patients can read and manage their existing records, but they can
      // never create new medications or prescriptions - only a pharmacist may
      // add those. Patients still need update/delete for refill stock,
      // automatic course expiry, and removing a medicine.
      match /medications/{medId} {
        allow read: if isSelf(uid) || isPharmacist();
        allow create: if isPharmacist();
        allow update, delete: if isSelf(uid) || isPharmacist();
      }

      match /prescriptions/{rxId} {
        allow read: if isSelf(uid) || isPharmacist();
        allow create: if isPharmacist();
        allow update, delete: if isSelf(uid) || isPharmacist();
      }

      match /history/{entryId} {
        allow read, write: if isSelf(uid) || isPharmacist();
      }

      match /reminders/{reminderId} {
        allow read: if isSelf(uid) || isPharmacist();
        allow write: if isSelf(uid) || isPharmacist();
      }

      match /wearableRecords/{recordId} {
        allow read: if isSelf(uid) || isPharmacist();
        allow write: if isSelf(uid);
      }

      match /emergencyContacts/{contactId} {
        allow read: if isSelf(uid) || isPharmacist();
        allow write: if isSelf(uid);
      }
    }
  }
}
